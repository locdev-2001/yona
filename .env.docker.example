# Reference for the Docker env (service names = docker hostnames). These values
# are already injected by docker-compose.yml (x-app-env), so you normally don't
# need to set them in .env — this file documents them (e.g. for prod/CI).
APP_URL=http://localhost:8080

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cho_rach
# Runtime role (non-superuser, RLS-enforced)
DB_USERNAME=cho_rach_app
DB_PASSWORD=secret
# Privileged owner role (migrations / DDL / audit / cross-workspace reads)
DB_PRIVILEGED_USERNAME=cho_rach_owner
DB_PRIVILEGED_PASSWORD=secret

REDIS_HOST=redis
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# Realtime (live chat) — Reverb
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=cho-rach
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http

# Vite dev server (node service)
VITE_DEV_SERVER_URL=http://localhost:5173
