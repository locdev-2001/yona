APP_NAME=Yona
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://yona.vn

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=yona
DB_USERNAME=yona_app
DB_PASSWORD=
DB_PRIVILEGED_USERNAME=yona_owner
DB_PRIVILEGED_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=yona.vn
SESSION_CONNECTION=default
SESSION_STORE=redis
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=yona_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=yona_database_

HORIZON_NAME=yona
HORIZON_PREFIX=yona_horizon:
HORIZON_MEMORY_LIMIT=64
HORIZON_MAX_PROCESSES=4
HORIZON_BALANCE_MAX_SHIFT=1
HORIZON_BALANCE_COOLDOWN=3

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@yona.vn"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=yona.vn
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

INERTIA_SSR_ENABLED=true
INERTIA_SSR_RUNTIME=node
INERTIA_SSR_URL=http://127.0.0.1:13714
INERTIA_SSR_ENSURE_RUNTIME_EXISTS=true
INERTIA_SSR_ENSURE_BUNDLE_EXISTS=true
INERTIA_SSR_THROW_ON_ERROR=false

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

TELESCOPE_ENABLED=false
PULSE_ENABLED=false
LOG_VIEWER_ENABLED=false

WIDGET_CHANNEL_INBOUND_SECRET=

INTEGRATION_ZALO_PERSONAL=true
ZALO_BRIDGE_URL=http://127.0.0.1:3710
ZALO_BRIDGE_WEBHOOK_SECRET=
ZALO_BRIDGE_SEND_SECRET=
ZALO_BRIDGE_UI_SECRET=
