APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8610
# Cổng của `php artisan serve` — Laravel đọc thẳng biến này, đừng truyền --port ở nơi khác.
SERVER_PORT=8610

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8611
REVERB_SERVER_PORT=8611
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Presence heartbeat (giây) — như PRESENCE_DURATION / CONTACT_PRESENCE_DURATION của Chatwoot
PRESENCE_DURATION=20
CONTACT_PRESENCE_DURATION=90

# Kênh Email (F1). Có MAILER_INBOUND_EMAIL_DOMAIN thì mỗi inbox email được cấp
# địa chỉ chuyển tiếp và thư trả lời dùng reply+<uuid>@<domain>.
MAILER_INBOUND_EMAIL_DOMAIN=
MAILER_SENDER_EMAIL=
SMTP_OPEN_TIMEOUT=15
SMTP_READ_TIMEOUT=30
EMAIL_PROCESSING_TIMEOUT_SECONDS=60
SKIP_INCOMING_BCC_PROCESSING=

# Kênh Zalo cá nhân (G1). Bridge Node chạy ở services/zalo-bridge; ba secret phải
# trùng với BRIDGE_*_SECRET / LARAVEL_WEBHOOK_SECRET trong services/zalo-bridge/.env.
ZALO_BRIDGE_URL=http://127.0.0.1:8612
ZALO_BRIDGE_WEBHOOK_SECRET=
ZALO_BRIDGE_SEND_SECRET=
ZALO_BRIDGE_UI_SECRET=

# SSRF: chặn URL webhook/avatar trỏ vào loopback, mạng nội bộ, link-local
# (169.254.169.254). Chỉ bật true ở máy dev/harness gọi localhost.
ALLOW_PRIVATE_WEBHOOK_URLS=false

# Ba dashboard vận hành, đều nằm sau guard super_admin: /horizon, /pulse,
# /log-viewer (xem docs/deployment.md mục 8).
# Horizon: số worker tối đa mà master nuôi ở production (thay DEPLOY_QUEUE_PROCESSES cũ).
HORIZON_MAX_PROCESSES=4
# Pulse ghi thẳng vào PostgreSQL dùng chung với dữ liệu khách — tắt hẳn hoặc
# hạ sample_rate nếu thấy độ trễ request tăng sau khi bật.
PULSE_ENABLED=true
