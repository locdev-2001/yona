APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8610
# Cổng của `php artisan serve` — Laravel đọc thẳng biến này, đừng truyền --port ở nơi khác.
SERVER_PORT=8610

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
# Phút, trượt theo lần thao tác cuối (43200 = 30 ngày). Console /admin tự
# hết hạn riêng sau SUPER_ADMIN_IDLE_MINUTES không thao tác.
SESSION_LIFETIME=43200
SUPER_ADMIN_IDLE_MINUTES=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Engine tìm kiếm (config/search.php); mặc định PostgreSQL. Meilisearch: xem
# docs/deployment.md mục "Tìm kiếm bằng Meilisearch".
SEARCH_DRIVER=pgsql
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_KEY=
# MEILISEARCH_SEARCH_KEY=
# MEILISEARCH_INDEX_PREFIX=yona_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Kho sticker: mặc định nằm trên đĩa (storage/app/public/stickers). Chuyển sang R2/S3
# thì bỏ comment và điền; ROOT là tiền tố trong bucket, URL là tên miền công khai
# KHÔNG kèm ROOT (Laravel tự nối ROOT vào đường dẫn). Trước khi bật:
# - composer require league/flysystem-aws-s3-v3 (driver s3 chưa có trong vendor);
# - thêm host của STICKERS_DISK_URL vào BRIDGE_FETCH_HOST_ALLOWLIST của zalo-bridge,
#   nếu không bridge chặn redirect sang host đó và sticker gửi ra Zalo đều hỏng.
# STICKERS_DISK_DRIVER=s3
# STICKERS_DISK_ROOT=stickers
# STICKERS_DISK_URL=https://stickers.example.com
# STICKERS_DISK_BUCKET=
# STICKERS_DISK_ENDPOINT=
# STICKERS_DISK_KEY=
# STICKERS_DISK_SECRET=
# STICKERS_DISK_REGION=auto
# STICKERS_DISK_USE_PATH_STYLE_ENDPOINT=false

# Dựng sticker từ ảnh tải lên (services/sticker-renderer, cài bằng
# `corepack pnpm --dir services/sticker-renderer install`). Tiến trình dựng bị cắt
# sau TIMEOUT giây và giới hạn bộ nhớ bằng `prlimit --data`; macOS không có prlimit
# nên chạy local trên macOS đặt STICKER_RENDERER_MEMORY_LIMITER=none.
# IMAGE_SIZE là cạnh (px) tệp sticker, đổi xong chạy `php artisan stickers:rerender`;
# DISPLAY_SIZE là cạnh (px CSS) khi hiện sticker; MAX_ORIGINAL_MB là trần ảnh gốc.
# STICKER_RENDERER=node
# STICKER_RENDERER_NODE_BINARY=node
# STICKER_RENDERER_TIMEOUT=10
# STICKER_RENDERER_MEMORY_LIMITER=prlimit
# STICKER_RENDERER_MEMORY_MB=512
# STICKER_IMAGE_SIZE=128
# STICKER_OUTBOUND_IMAGE_SIZE=128
# STICKER_DISPLAY_SIZE= (mặc định bằng STICKER_IMAGE_SIZE)
# STICKER_MAX_ORIGINAL_MB=10

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8611
REVERB_SERVER_PORT=8611
REVERB_SCHEME=http
# Byte tối đa của một lượt Laravel đẩy sự kiện tới Reverb; vượt là sự kiện mất lặng lẽ (413).
REVERB_MAX_REQUEST_SIZE=10485760
# Byte tối đa của một khung WebSocket trình duyệt gửi lên.
REVERB_APP_MAX_MESSAGE_SIZE=65536

# Đường Laravel gọi Reverb từ chính server. Bỏ trống = dùng REVERB_* ở trên
# (đúng cho máy dev). Production trỏ loopback để không đi vòng qua DNS và CDN.
REVERB_INTERNAL_HOST=
REVERB_INTERNAL_PORT=
REVERB_INTERNAL_SCHEME=

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Presence heartbeat (giây): nhân viên / liên hệ coi là đang trực tuyến trong bấy nhiêu giây sau nhịp cuối
PRESENCE_DURATION=30
CONTACT_PRESENCE_DURATION=90

# Kênh Email (F1). Có MAILER_INBOUND_EMAIL_DOMAIN thì mỗi inbox email được cấp
# địa chỉ chuyển tiếp và thư trả lời dùng reply+<uuid>@<domain>.
MAILER_INBOUND_EMAIL_DOMAIN=
MAILER_SENDER_EMAIL=
SMTP_OPEN_TIMEOUT=15
SMTP_READ_TIMEOUT=30
IMAP_READ_TIMEOUT=20
IMAP_SLOW_FETCH_MS=10000
IMAP_LOGOUT_TIMEOUT=2
IMAP_RETRY_MAX_SECONDS=600
EMAIL_PROCESSING_TIMEOUT_SECONDS=60
SKIP_INCOMING_BCC_PROCESSING=

# Kênh Zalo cá nhân (G1). Bridge Node chạy ở services/zalo-bridge; ba secret phải
# trùng với BRIDGE_*_SECRET / LARAVEL_WEBHOOK_SECRET trong services/zalo-bridge/.env.
ZALO_BRIDGE_URL=http://127.0.0.1:8612
ZALO_BRIDGE_WEBHOOK_SECRET=
ZALO_BRIDGE_SEND_SECRET=
ZALO_BRIDGE_UI_SECRET=

# Đăng nhập / đăng ký bằng Google (OAuth client loại "Web application" trên Google
# Cloud, xem docs/deployment.md mục đăng nhập Google). Để trống = ẩn nút Google.
# GOOGLE_REDIRECT_URI bỏ trống thì dùng <host đang chạy>/app/auth/oauth/google/callback;
# production đặt rõ https://yona.vn/app/auth/oauth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Kết nối HỘP THƯ email bằng OAuth (khác đăng nhập Yona ở trên), xem docs/deployment.md
# mục "Kết nối hộp thư email bằng OAuth". Redirect URI khai ở nhà cung cấp:
# {APP_URL}/app/email/oauth/google/callback và {APP_URL}/app/email/oauth/microsoft/callback.
# Gmail OAuth KHOÁ tới khi Google duyệt scope https://mail.google.com/ (để false);
# client id/secret Gmail bỏ trống thì dùng lại GOOGLE_CLIENT_ID/SECRET.
GOOGLE_MAIL_OAUTH_ENABLED=false
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
# Outlook/Microsoft 365: app đăng ký ở Azure (Entra ID). Trống = ẩn thẻ "Đăng nhập Microsoft".
MICROSOFT_MAIL_CLIENT_ID=
MICROSOFT_MAIL_CLIENT_SECRET=
MICROSOFT_MAIL_TENANT=common

# Bề mặt bán hàng. Trang /dat-lich-demo đổ lead vào một hộp thư kênh API của
# chính Yona — lead thành hội thoại đến, nằm cùng chỗ với tin khách.
# Chưa có YONA_LEAD_INBOX_ID thì form BÁO LỖI kèm hotline/Zalo, không hiện
# trang cảm ơn giả. Hotline và link Zalo để rỗng thì trang ẩn khối liên hệ
# nhanh thay vì bày một số không ai bắt máy.
YONA_LEAD_INBOX_ID=
YONA_HOTLINE=
YONA_ZALO_CONTACT_URL=

# Tài khoản có quyền hệ thống: email user cách nhau bằng dấu phẩy. Chỉ họ mới
# quản lý kho sticker nền tảng (kho chung mọi account thấy) và dùng kho sticker
# riêng khi account chưa bật cờ custom_stickers. Để trống = không ai có quyền.
YONA_SYSTEM_ADMIN_EMAILS=

# Analytics không cookie (Plausible) đi qua đường dẫn first-party PLAUSIBLE_PROXY_PATH
# trên domain app (/yv/s script, /yv/e sự kiện) để trình chặn quảng cáo không chặn.
# Để trống PLAUSIBLE_HOST hoặc PLAUSIBLE_SCRIPT_PATH = tắt analytics (máy dev).
# Production: PLAUSIBLE_HOST=https://analytics.beru.io.vn, PLAUSIBLE_SCRIPT_PATH=/js/pa-….js
# của site trên máy chủ Plausible, PLAUSIBLE_CLIENT_IP_HEADER=CF-Connecting-IP vì app đứng
# sau Cloudflare (thiếu thì Plausible thấy IP máy chủ và loại sự kiện).
PLAUSIBLE_HOST=
PLAUSIBLE_SCRIPT_PATH=
PLAUSIBLE_PROXY_PATH=/yv
PLAUSIBLE_CLIENT_IP_HEADER=

# SSRF: chặn URL webhook/avatar trỏ vào loopback, mạng nội bộ, link-local
# (169.254.169.254). Chỉ bật true ở máy dev/harness gọi localhost.
ALLOW_PRIVATE_WEBHOOK_URLS=false

# Ba dashboard vận hành, đều nằm sau guard super_admin: /horizon, /pulse,
# /log-viewer (xem docs/deployment.md mục 8).
# Horizon: số worker CỐ ĐỊNH của từng pool ở production (docs/deployment.md mục 8).
HORIZON_REALTIME_PROCESSES=2
HORIZON_MAX_PROCESSES=4
HORIZON_MEDIA_PROCESSES=2
# Pulse ghi thẳng vào PostgreSQL dùng chung với dữ liệu khách — tắt hẳn hoặc
# hạ sample_rate nếu thấy độ trễ request tăng sau khi bật.
PULSE_ENABLED=true

# Cảnh báo vận hành qua Telegram (App\Support\Alerts\OpsAlerter): job lỗi,
# Horizon/Reverb/zalo-bridge chết. Để trống = chỉ ghi log (storage/logs),
# không chặn ứng dụng. Tạo bot bằng @BotFather, lấy chat id bằng cách nhắn bot
# rồi gọi https://api.telegram.org/bot<token>/getUpdates.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# Đọc DB production (PostgreSQL, chỉ đọc) qua SSH tunnel — chỉ dùng ở máy dev, cho
# .claude/skills/yona-issues/scripts/prod-db.sh. Dựng phía server: references/prod-db-setup.md.
PROD_DB_SSH_HOST=
PROD_DB_SSH_PORT=22
PROD_DB_SSH_USER=dbtunnel
PROD_DB_SSH_KEY=~/.ssh/yona_prod_db
PROD_DB_NAME=yona
PROD_DB_USER=yona_readonly
PROD_DB_PASSWORD=

# Deploy production qua cổng SSH (.claude/skills/yona-deploy) — chỉ dùng ở máy dev.
# Key chỉ chạy được /usr/local/sbin/yona-deploy-gate; cài phía server: .claude/skills/yona-deploy/references/server-setup.md.
PROD_DEPLOY_SSH_HOST=
PROD_DEPLOY_SSH_PORT=22
PROD_DEPLOY_SSH_USER=root
PROD_DEPLOY_SSH_KEY=~/.ssh/id_ed25519

# Token chỉ đọc của API Log Viewer. Production: bật đường Bearer token (để trống = tắt).
# Máy dev: .claude/skills/yona-debug/scripts/prod-logs.sh lấy đúng biến này để gọi yona.vn.
LOG_VIEWER_API_TOKEN=

# Ký + mã hoá request nhắn tin từ trình duyệt (docs/system-architecture.md §10). false = rollback tức thì.
REQUEST_SIGNING_ENABLED=true
