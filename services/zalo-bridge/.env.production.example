LARAVEL_WEBHOOK_URL=https://yona.vn/webhooks/zalo
LARAVEL_WEBHOOK_SECRET=
LARAVEL_BASE_URL=https://yona.vn

BRIDGE_HTTP_HOST=127.0.0.1
BRIDGE_HTTP_PORT=8612
BRIDGE_SEND_SECRET=
BRIDGE_UI_SECRET=
BRIDGE_ELEVATED_SECRET=

# Optional extra hosts for media downloads, comma-separated. Hosts of
# LARAVEL_WEBHOOK_URL and LARAVEL_BASE_URL (yona.vn) are allowed automatically;
# add the APP_URL host here only when it differs from both.
BRIDGE_FETCH_HOST_ALLOWLIST=

# ffmpeg/ffprobe for playable videos; empty = look up in PATH (docs/deployment.md, mục 6).
FFMPEG_PATH=
FFPROBE_PATH=

ZALO_BRIDGE_LOG_QUOTE=0
ZALO_BRIDGE_DEBUG_FRIEND_REQUESTS=0
ZALO_BRIDGE_SWAP_REQ_STATUS=0
