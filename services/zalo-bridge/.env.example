# Zalo Personal Bridge — env template
# Prefer 127.0.0.1: Node may resolve localhost to ::1 while php artisan serve listens on IPv4 only → ECONNREFUSED
LARAVEL_WEBHOOK_URL=http://127.0.0.1:8610/webhooks/zalo
LARAVEL_WEBHOOK_SECRET=change-me-strong-secret
LARAVEL_BASE_URL=http://127.0.0.1:8610

BRIDGE_HTTP_HOST=127.0.0.1
BRIDGE_HTTP_PORT=8612
BRIDGE_SEND_SECRET=change-me-send-secret
BRIDGE_UI_SECRET=change-me-ui-secret
# P11: secret RIENG cho 39 method destructive qua POST /zca/:method (header
# X-Bridge-Elevated-Secret). Rong = khong bao gio elevated (fail-closed).
# Quyen that gate o Laravel: TenantPermission::ZaloDestructive.
BRIDGE_ELEVATED_SECRET=

# Optional: override default User-Agent for zca-js
# ZCA_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:133.0) Gecko/20100101 Firefox/133.0

# Extra hosts allowed when downloading outbound attachments, comma-separated.
# Hosts of LARAVEL_WEBHOOK_URL and LARAVEL_BASE_URL are allowed automatically.
# Add the APP_URL host here when it differs from both (e.g. APP_URL=http://localhost:8610
# while the bridge talks to 127.0.0.1) — otherwise sending media fails with
# fetch_host_not_allowed and the message shows up as "not connected" in Yona.
# BRIDGE_FETCH_HOST_ALLOWLIST=localhost,cdn.example.com

# Optional: ffmpeg/ffprobe for sending videos as playable Zalo videos (default: found in PATH).
# Missing either one → videos are sent as .mp4 files, as before.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Optional: debug flags
# ZALO_BRIDGE_LOG_QUOTE=0
# ZALO_BRIDGE_DEBUG_FRIEND_REQUESTS=0
# ZALO_BRIDGE_SWAP_REQ_STATUS=0

# OUTBOX (Tier 1 persistent delivery):
# Files luu tai .outbox/ va .outbox-dead/ (relative to services/zalo-bridge/).
# Khong can config them — tu dong tao.
# QUAN TRONG: PM2 PHAI chay instances:1 exec_mode:fork.
# File-based outbox khong an toan multi-process (khong co file-lock).
# ecosystem.config.cjs da dat instances:1/fork — KHONG doi thanh cluster.
