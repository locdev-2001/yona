{
    "name": "zalo-personal-bridge",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Bridge zca-js (Zalo cá nhân) → Laravel webhook + HTTP send (channel-zalo module)",
    "main": "src/index.mjs",
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "dev": "node src/index.mjs",
        "start": "pnpm install && pnpm pm2:start",
        "pm2:start": "pm2 start ecosystem.config.cjs",
        "pm2:stop": "pm2 stop zalo-personal-bridge",
        "pm2:logs": "pm2 logs zalo-personal-bridge",
        "pm2:restart": "pm2 restart zalo-personal-bridge"
    },
    "dependencies": {
        "@resvg/resvg-js": "^2.6.2",
        "dotenv": "^16.4.5",
        "express": "^4.21.2",
        "multer": "^2.0.0",
        "pm2": "^6.0.8",
        "satori": "^0.33.5",
        "sharp": "^0.33.5",
        "zca-js": "2.2.0"
    }
}
