{
    "version": "0.0.1",
    "configurations": [
        {
            "name": "yona",
            "runtimeExecutable": "php",
            "runtimeArgs": [
                "artisan",
                "serve"
            ],
            "port": 8610
        },
        {
            "name": "zalo-bridge",
            "runtimeExecutable": "node",
            "runtimeArgs": [
                "services/zalo-bridge/src/index.mjs"
            ],
            "port": 8612
        },
        {
            "name": "reverb",
            "runtimeExecutable": "php",
            "runtimeArgs": [
                "artisan",
                "reverb:start"
            ],
            "port": 8611
        },
        {
            "name": "worker",
            "runtimeExecutable": "php",
            "runtimeArgs": [
                "artisan",
                "queue:listen",
                "--queue=critical,high,medium,default,mailers,low,scheduled_jobs,purgable,stickers",
                "--tries=1"
            ]
        }
    ]
}
