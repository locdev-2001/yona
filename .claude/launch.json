{
    "version": "0.0.1",
    "configurations": [
        {
            "name": "yona",
            "runtimeExecutable": "php",
            "runtimeArgs": [
                "artisan",
                "serve"
            ],
            "port": 8610
        },
        {
            "name": "vite",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "port": 5173,
            "autoPort": true
        },
        {
            "name": "zalo-bridge",
            "runtimeExecutable": "node",
            "runtimeArgs": [
                "services/zalo-bridge/src/index.mjs"
            ],
            "port": 8612
        },
        {
            "name": "messenger-bridge",
            "runtimeExecutable": "bash",
            "runtimeArgs": [
                "-c",
                "cd services/messenger-bridge && PATH=$HOME/.local/go/bin:$PATH GOTOOLCHAIN=local go run ."
            ],
            "port": 8614
        },
        {
            "name": "reverb",
            "runtimeExecutable": "php",
            "runtimeArgs": [
                "artisan",
                "reverb:start"
            ],
            "port": 8611
        },
        {
            "name": "worker",
            "runtimeExecutable": "php",
            "runtimeArgs": [
                "artisan",
                "queue:listen",
                "--queue=critical,high,media,medium,default,mailers,low,scheduled_jobs,purgable,stickers",
                "--tries=1"
            ]
        },
        {
            "name": "livekit",
            "runtimeExecutable": "bash",
            "runtimeArgs": [
                "services/livekit/dev.sh"
            ],
            "port": 8613
        }
    ]
}
